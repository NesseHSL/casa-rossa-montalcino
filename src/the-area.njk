---
permalink: the-area.html
---
{% extends "base.njk" %}
{% set page_data = area %}
{% block main %}
{% include "hero-short.njk" %}

<section class="location" id="location">
  <div class="wrap">
    <div class="reveal">
      <p class="eyebrow">{{ area.location.eyebrow | e }}</p>
      <h2>{{ area.location.heading | e }}</h2>
      <p class="muted">{{ area.location.text | inline | safe }}</p>
      <ul class="distances">
{%- for d in area.location.distances %}
        <li><span>{{ d.place | e }}</span><span>{{ d.time | e }}</span></li>
{%- endfor %}
      </ul>
      <p class="area-note">{{ area.location.note | inline | safe }}</p>
    </div>
    <iframe class="map reveal" title="Map of the area around Castelgiocondo, Montalcino" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=11.24%2C42.96%2C11.62%2C43.14&amp;layer=mapnik&amp;marker=43.0458%2C11.4214"></iframe>
  </div>
</section>

<section id="explore" class="explore">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">{{ area.explore.eyebrow | e }}</p>
      <h2>{{ area.explore.heading | e }}</h2>
    </div>
    <div class="explore-grid">
{%- for g in area.explore.groups %}
      <div class="reveal"><h3>{{ g.title | e }}</h3><ul>{% for item in g.items %}<li>{{ item | inline | safe }}</li>{% endfor %}</ul></div>
{%- endfor %}
    </div>
  </div>
</section>

{% include "cta.njk" %}
{% endblock %}
