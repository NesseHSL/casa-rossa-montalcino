<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ page_data.meta_title | e }}</title>
  <meta name="description" content="{{ page_data.meta_description | e }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body{% if body_class %} class="{{ body_class }}"{% endif %}>

<header class="site-header{% if header_solid %} solid{% endif %}" id="top">
  <a class="wordmark" href="{{ home_link or 'index.html' }}">Casa Rossa</a>
  <button class="menu-toggle" aria-expanded="false" aria-controls="nav">Menu</button>
  <nav class="nav" id="nav">
    <a href="floorplans.html">The House</a>
    <a href="the-area.html">The Area</a>
    <a href="services.html">The Experience</a>
    <a href="gallery.html">The Gallery</a>
    <a class="nav-cta" href="booking.html">Booking</a>
  </nav>
</header>

{% block main %}{% endblock %}

<footer>
  <div class="wrap">
    <div>
      <a class="wordmark" href="{{ home_link or 'index.html' }}">Casa Rossa</a>
      <p>{{ settings.footer_location | e }}</p>
    </div>
    <div>
{% if footer_enquire %}
      <p><a href="index.html#enquire">Enquire about a stay</a></p>
{% else %}
      <p>Email {% if settings.email %}<a href="mailto:{{ settings.email | e }}">{{ settings.email | e }}</a>{% else %}<span class="todo">to add</span>{% endif %}<br>Instagram {% if settings.instagram %}<a href="https://www.instagram.com/{{ settings.instagram | replace('@', '') | e }}/">{{ settings.instagram | e }}</a>{% else %}<span class="todo">to add</span>{% endif %}</p>
      <p>CIN {% if settings.cin %}{{ settings.cin | e }}{% else %}<span class="todo">to add</span>{% endif %}</p>
{% endif %}
    </div>
  </div>
</footer>

<script src="script.js"></script>
</body>
</html>
